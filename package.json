{
  "name": "lynxbot-neo",
  "version": "0.5.0-beta",
  "description": "A simple discord.js bot template written in nodejs",
  "main": "lib/bot.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "debug": "nodemon --inspect .",
    "setup": "node ./lib/utils/setup.js",
    "start": "node ."
  },
  "keywords": [
    "bot",
    "discordjs",
    "nodejs",
    "framework"
  ],
  "author": "NovaLynxie",
  "license": "ISC",
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "common-tags": "^1.8.2",
    "discord-html-transcripts-v2": "^3.3.2",
    "discord.js": "^14.25.1",
    "dotenv": "^16.4.7",
    "music-metadata": "^11.12.3",
    "sequelize": "^6.37.8",
    "sodium-native": "^4.3.1",
    "sqlite3": "^6.0.1",
    "toml": "^3.0.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "nodemonConfig": {
    "delay": 5000,
    "ignore": [
      "lib/commands/*",
      "lib/events/*",
      "logs/*"
    ]
  }
}
