# Discord Bot Application Environment Configuration
# Bot Discord Configuration
CALLBACK_URL=https://localhost:<PORT>/auth/callback
CLIENT_ID=<DISCORD_BOT_CLIENT_ID>
CLIENT_SECRET=<DISCORD_BOT_CLIENT_SECRET>
DISCORD_TOKEN=<DISCORD_BOT_TOKEN>
# Bot Database Configuration
DB_USERNAME=<DB_USERNAME>
DB_PASSWORD=<DB_PASSWORD>
# App Runtime Configuration
LOG_LEVEL=error
NODE_ENV=production